# Local defaults. Copy this file to backend/.env and edit the copy.
OPEN_CHOICE_READER_DATABASE_URL=sqlite:///./data/open_choice_reader.db
OPEN_CHOICE_READER_STORAGE_ROOT=data
OPEN_CHOICE_READER_SOURCE_ROOT=data/source
OPEN_CHOICE_READER_CACHE_ROOT=data/cache
OPEN_CHOICE_READER_EXPORT_ROOT=data/exports
OPEN_CHOICE_READER_INBOX_ROOT=data/inbox
OPEN_CHOICE_READER_SEED_DOWNLOAD_ROOT=data/seed-downloads

# Keep false for local HTTP. Set true only when the app is served through HTTPS.
OPEN_CHOICE_READER_AUTH_SESSION_COOKIE_NAME=open_choice_reader_session
OPEN_CHOICE_READER_AUTH_SESSION_SECURE=false
OPEN_CHOICE_READER_AUTH_SESSION_SAMESITE=lax
OPEN_CHOICE_READER_AUTH_SESSION_TTL_HOURS=168
OPEN_CHOICE_READER_AUTH_PASSWORD_MIN_LENGTH=12
OPEN_CHOICE_READER_AUTH_LOGIN_MAX_ATTEMPTS=10
OPEN_CHOICE_READER_AUTH_LOGIN_WINDOW_SECONDS=300

# Required for initial administrator setup from a non-loopback client.
OPEN_CHOICE_READER_AUTH_BOOTSTRAP_TOKEN=

# Comma-separated exact origins. Add only origins that should make credentialed API requests.
OPEN_CHOICE_READER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Example for one unpacked Chromium extension: ^chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef$
OPEN_CHOICE_READER_CORS_ALLOWED_ORIGIN_REGEX=

OPEN_CHOICE_READER_REMOTE_FETCH_ALLOW_PRIVATE_HOSTS=false
OPEN_CHOICE_READER_REMOTE_METADATA_MAX_BYTES=5242880
OPEN_CHOICE_READER_REMOTE_IMAGE_MAX_BYTES=10485760
OPEN_CHOICE_READER_REMOTE_DOCUMENT_MAX_BYTES=52428800
OPEN_CHOICE_READER_REMOTE_AUDIO_MAX_BYTES=26214400
OPEN_CHOICE_READER_DOCUMENT_UPLOAD_MAX_BYTES=52428800
OPEN_CHOICE_READER_EPUB_MAX_ENTRIES=5000
OPEN_CHOICE_READER_EPUB_MAX_MEMBER_BYTES=52428800
OPEN_CHOICE_READER_EPUB_MAX_UNCOMPRESSED_BYTES=209715200
OPEN_CHOICE_READER_EPUB_MAX_COMPRESSION_RATIO=200
OPEN_CHOICE_READER_VOICE_UPLOAD_MAX_BYTES=26214400
OPEN_CHOICE_READER_THEME_UPLOAD_MAX_BYTES=1048576
OPEN_CHOICE_READER_FRONTEND_DIST_ROOT=../frontend/dist

OPEN_CHOICE_READER_METADATA_ENRICHMENT_ENABLED=true
OPEN_CHOICE_READER_METADATA_REQUEST_TIMEOUT_SECONDS=10
OPEN_CHOICE_READER_PROJECT_GUTENBERG_TOP_URL=https://www.gutenberg.org/browse/scores/top
OPEN_CHOICE_READER_GUTENDEX_API_BASE=https://gutendex.com/books
OPEN_CHOICE_READER_OPEN_LIBRARY_SEARCH_URL=https://openlibrary.org/search.json
OPEN_CHOICE_READER_OPEN_LIBRARY_COVER_BASE=https://covers.openlibrary.org/b/id

OPEN_CHOICE_READER_TTS_ENGINE=piper
OPEN_CHOICE_READER_PIPER_BINARY=piper
OPEN_CHOICE_READER_PIPER_MODEL_PATH=data/models/piper/default.onnx
OPEN_CHOICE_READER_KOKORO_BINARY=kokoro-onnx
OPEN_CHOICE_READER_KOKORO_MODEL_PATH=data/models/kokoro/kokoro-v1.0.onnx
OPEN_CHOICE_READER_KOKORO_VOICES_PATH=data/models/kokoro/voices-v1.0.bin
OPEN_CHOICE_READER_QWEN_CLONE_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-0.6B-Base
OPEN_CHOICE_READER_QWEN_CLONE_LARGE_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-Base
OPEN_CHOICE_READER_VOICE_TRANSCRIPTION_MODEL_NAME=base.en
OPEN_CHOICE_READER_VOICE_TRANSCRIPTION_DEVICE=cpu
OPEN_CHOICE_READER_VOICE_TRANSCRIPTION_COMPUTE_TYPE=int8

OPEN_CHOICE_READER_WORKER_STALE_JOB_MINUTES=15
OPEN_CHOICE_READER_AUDIO_CACHE_MAX_GB=8
OPEN_CHOICE_READER_AUDIO_CACHE_EVICTION_MINUTES=30
